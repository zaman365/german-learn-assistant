# Production requires a PostgreSQL service. Development may use DEV_DATABASE_PATH instead.
DATABASE_URL=postgresql://german:german@localhost:5432/german
# DEV_DATABASE_PATH=.data/development
APP_URL=http://localhost:4173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_AUDIO_ANALYSIS_MODEL=
AI_DAILY_REQUEST_LIMIT=40
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WORKER_ENABLED=false
