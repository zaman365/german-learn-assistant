{
  "name": "german-learn-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/clean-standalone.mjs",
    "start": "next start --hostname 0.0.0.0 --port 4173",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "owner:create": "node --import tsx scripts/owner.ts create",
    "owner:reset-password": "node --import tsx scripts/owner.ts reset-password",
    "worker": "node --import tsx src/jobs/worker.ts",
    "audio": "node --import tsx scripts/audio.ts",
    "exam:audio": "node --import tsx scripts/exam-audio.ts",
    "format": "prettier --write src content scripts tests *.ts *.mts *.mjs *.json compose.yaml .github/workflows/ci.yml",
    "format:check": "prettier --check src content scripts tests",
    "content:coverage": "node --import tsx scripts/coverage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "openai": "7.21.0",
    "pg": "8.23.0",
    "pg-boss": "12.33.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "prettier": "3.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
