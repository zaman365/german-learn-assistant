# Copy outside the repository, restrict permissions to the operator, and supply real staging values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_URL=https://YOUR-STAGING-HOST
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
S3_ENDPOINT=https://YOUR-PRIVATE-S3-ENDPOINT
S3_REGION=YOUR_REGION
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=REPLACE_PRIVATELY
S3_SECRET_ACCESS_KEY=REPLACE_PRIVATELY
STORAGE_DRIVER=s3
WORKER_ENABLED=true
# Leave unavailable models empty. These fields do not constitute real-provider verification.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_AUDIO_ANALYSIS_MODEL=
AI_DAILY_REQUEST_LIMIT=40
# OWNER_PASSWORD belongs only in the one-off bootstrap/reset environment, not the running services.
